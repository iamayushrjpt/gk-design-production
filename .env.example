# Copy to .env for Docker Compose. Keep real credentials out of Git.
SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/gkdesign_test
PORT=8081
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
WHATSAPP_BUSINESS_NUMBER=919999999999
ADMIN_EMAIL=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://images-test.example.com
R2_ACCESS_KEY=REPLACE_WITH_R2_ACCESS_KEY
R2_SECRET_KEY=REPLACE_WITH_R2_SECRET_KEY
R2_BUCKET=gk-design-media-test
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
